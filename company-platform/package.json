{
  "name": "company-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Shared discovery platform for two independent companies \u2014 Velaqori Systems and Tamuzi Learning (working names).",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run db:check && npm run typecheck && npm run test && npm run config:check && npm run build",
    "db:embed": "node scripts/embed-migrations.mjs",
    "db:check": "node scripts/embed-migrations.mjs --check",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "config:check": "tsx scripts/config-check.ts",
    "mail:verify": "tsx scripts/mail-verify.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@electric-sql/pglite": "0.5.11",
    "drizzle-orm": "0.45.4",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "0.31.11",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12",
    "@tailwindcss/postcss": "^4.3.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "esbuild": "^0.25.4"
  }
}
