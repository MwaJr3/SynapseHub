# Copy to .env.local and fill in real values before any public deployment.
AUTH_SECRET=
AUTH_TRUST_HOST=true
# PostgreSQL 14+ — leave unset for embedded PGlite (./data/)
DATABASE_URL=
# Storage for resume files: local (default) or s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./data/uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# Contact delivery goes through Brevo. Each company has its own inbox and the
# two are never shared. Until BREVO_API_KEY and CONTACT_FROM_EMAIL are set the UI
# shows a setup-required state and never claims a message was sent.
BREVO_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=
CONTACT_VELAQORI_EMAIL=
CONTACT_TAMUZI_EMAIL=
# The sender address above must be verified in Brevo, otherwise the provider
# rejects the message and the UI reports the failure honestly.
# Public origin used for canonical URLs and sitemap once a domain exists.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------- assistants
# The IT-triage assistant (Velaqori) and the study-planning helper (Tamuzi) use
# one OpenAI-compatible endpoint, chosen here. They are OFF until all three of
# these are set; the pages then say so instead of showing a chat box that cannot
# answer. The token is read server-side only and never reaches the browser.
#
# Hugging Face (intended default — one token, many open-weight models):
#   ASSISTANT_BASE_URL=https://router.huggingface.co/v1
#   ASSISTANT_MODEL=meta-llama/Llama-3.3-70B-Instruct
#   ASSISTANT_API_KEY=hf_...            (or HUGGINGFACE_API_KEY / HF_TOKEN)
#
# Free alternatives:
#   Groq        https://api.groq.com/openai/v1                      openai/gpt-oss-20b
#   OpenRouter  https://openrouter.ai/api/v1                        <model>:free
#
# Local, no account and no quota (needs the model downloaded):
#   ASSISTANT_BASE_URL=http://127.0.0.1:11434/v1
#   ASSISTANT_MODEL=qwen2.5:3b
#   (no ASSISTANT_API_KEY needed for a local host)
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=

# ------------------------------------------------------- the learning systems
# The umbrella page (/ecosystem) lists the Tamuzi systems and links the ones that
# have a front door. Nothing is hard-coded: an unset value means "not deployed
# yet" is shown instead of a link that goes nowhere.
# NEXT_PUBLIC_TESSERA_URL=https://tessera.example.com
# NEXT_PUBLIC_REACHLEARN_URL=
# NEXT_PUBLIC_OPENLEARN_URL=
# NEXT_PUBLIC_EDUACCESS_URL=

# ---------------------------------------------------------------- AI provider
# Named providers now work by name, so only two values are needed. Explicitness
# still wins: setting ASSISTANT_BASE_URL/_MODEL overrides the preset.
#   ASSISTANT_PROVIDER=ollama-cloud   ASSISTANT_API_KEY=...   (model defaults to
#                                                             nemotron-3-nano:30b)
#   ASSISTANT_PROVIDER=huggingface    ASSISTANT_API_KEY=hf_...
#   ASSISTANT_PROVIDER=ollama-local   (no key; model qwen2.5:3b)
# Ollama Cloud's endpoint, model ids and account limits are from the provider's
# own example and are NOT verified from this repository.
ASSISTANT_PROVIDER=

# ------------------------------------------------ Tessera (study planner link)
# The study planner can show a learner their Tessera progress, but only after the
# learner approves a read-only grant on Tessera's own consent screen. Set all three
# or none: with any missing the panel says the deployment has no connection and the
# planner carries on without progress data. No tokens are stored in this file and
# none are ever printed to logs.
# TESSERA_BASE_URL=https://tessera.example.com
# TESSERA_PLANNER_CLIENT_ID=tamuzi-study-planner
# TESSERA_PLANNER_REDIRECT_URI=https://planner.example.com/api/tessera/callback
TESSERA_BASE_URL=
TESSERA_PLANNER_CLIENT_ID=
TESSERA_PLANNER_REDIRECT_URI=
