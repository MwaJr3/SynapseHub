{
  "name": "synapsehub-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mwangala's frontend portfolio and 60 interactive challenge prototypes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "registry": "node scripts/build-registry.mjs",
    "catalogue": "node scripts/build-catalogue.mjs",
    "ux:scan": "vite-node tools/northstar/engine/scan.ts",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:report": "playwright show-report",
    "og:image": "node scripts/generate-og-image.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json,md}\"",
    "ux:audit": "node tools/northstar/bin/northstar.mjs audit .",
    "ux:check": "node tools/northstar/bin/northstar.mjs check .",
    "ux:test": "node --test \"tools/northstar/test/*.test.mjs\"",
    "ux": "node tools/northstar/bin/northstar.mjs audit .",
    "ux:check:all": "node tools/northstar/bin/northstar.mjs check . --min P3",
    "ux:fix": "node tools/northstar/bin/northstar.mjs fix .",
    "ux:watch": "node tools/northstar/bin/northstar.mjs watch . --fix",
    "ux:hooks": "node tools/northstar/bin/northstar.mjs hooks",
    "ux:report": "node tools/northstar/bin/northstar.mjs audit . --out docs/ux/audit-repository.md",
    "ux:knowledge:validate": "node tools/northstar/scripts/validate-knowledge.mjs validate tools/northstar/knowledge/records",
    "ux:videos:import": "node tools/northstar/scripts/import-videos.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@supabase/supabase-js": "^2.99.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.7",
    "vite-node": "^5.3.0",
    "vitest": "^4.1.12"
  }
}
