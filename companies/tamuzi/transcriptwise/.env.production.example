# TEMPLATE ONLY: set the actual domain, secret and provider values before deploying.
APP_ENV=production
COOKIE_SECURE=true
ALLOWED_HOSTS=learn.example.com,localhost,127.0.0.1
ALLOWED_ORIGINS=https://learn.example.com
POSTGRES_PASSWORD=
APP_PORT=8000
APP_BIND=127.0.0.1
SERVE_FRONTEND=true
WORKER_ENABLED=true
# Compose supplies DATABASE_URL to the app. For a non-Compose service set:
# DATABASE_URL=postgresql+psycopg://USER:URL_ENCODED_PASSWORD@DB_HOST:5432/transcriptwise
AI_PROVIDER=local
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_CHUNK_CHARS=18000
AI_MAX_OUTPUT_TOKENS=6500
AI_TIMEOUT_SECONDS=120
YOUTUBE_ALLOWED_VIDEO_IDS=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
GUEST_RETENTION_DAYS=7
UNSAVED_RETENTION_DAYS=30
SESSION_DAYS=14
MAX_UPLOAD_BYTES=2000000
MAX_TRANSCRIPT_CHARS=300000
MIN_TRANSCRIPT_CHARS=80
DAILY_ANALYSIS_LIMIT=30
REQUESTS_PER_MINUTE=120
EXPENSIVE_REQUESTS_PER_HOUR=30
