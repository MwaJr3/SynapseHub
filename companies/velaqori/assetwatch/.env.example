# AssetWatch — authorized asset/exposure monitoring only.
DATABASE_URL=sqlite:///./data/assetwatch.db
# Scans run ONLY against explicitly allowlisted targets, validated server-side
# on every request. "import" ingests manually supplied results; "simulated"
# produces labelled demo data; "nmap" is opt-in and requires nmap installed.
SCAN_MODE=import
MAX_TARGETS_PER_SCAN=8
MAX_PORTS_PER_SCAN=100
SCAN_TIMEOUT_SECONDS=120
