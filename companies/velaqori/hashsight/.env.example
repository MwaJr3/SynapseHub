# HashSight — local development defaults. No real secrets.
DATABASE_URL=sqlite:///./data/hashsight.db
# Reputation providers are OPT-IN. "demo" never touches the network; the
# digests of uploaded files never leave the machine in demo mode.
PROVIDER_MODE=demo
PROVIDER_API_KEY=
PROVIDER_BASE_URL=
MAX_UPLOAD_BYTES=5000000
RETENTION_DAYS=365
