# Copy to .env for Docker Compose or export the backend values for local runs.
# Never commit a real .env file.

# --- Docker Compose service settings ---
WEB_PORT=5174
API_PORT=8000
INSTALL_ML=false

POSTGRES_DB=vocal_separator
POSTGRES_USER=vocal_separator
POSTGRES_PASSWORD=change-this-password

# --- Backend security ---
# Use a long, random value in every real deployment.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_HOURS=72
DOWNLOAD_TOKEN_TTL=3600
# Optional: the first/admin account email recognized by the backend.
ADMIN_EMAIL=

# --- Local backend storage/database overrides ---
# Docker Compose sets DATABASE_URL to the bundled PostgreSQL service.
# For a zero-config local run you may leave DATABASE_URL unset (SQLite default)
# or set e.g. postgresql+psycopg://user:password@localhost:5432/vocal_separator
DATA_DIR=./backend/data
STORAGE_DIR=./backend/data/storage
DATABASE_URL=
QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# --- Upload and retention limits ---
MAX_UPLOAD_MB=100
MAX_DURATION_S=1200
RETENTION_DAYS=7
WORKER_THREADS=1

# --- Separation engine ---
# auto = Demucs when genuinely available, otherwise the real DSP fallback.
# dsp  = always use the built-in exact-sum DSP engine.
# demucs = require Demucs and fail clearly if unavailable.
SEPARATION_ENGINE=auto
DEMUCS_MODEL=htdemucs
FFMPEG_BINARY=ffmpeg
