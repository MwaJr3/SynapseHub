# Copy to .env.local and fill in real values. Nothing here ships secrets.
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Optional OAuth (credentials sign-in works without these)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# PostgreSQL 14+ — leave unset for embedded PGlite (./data/)
DATABASE_URL=
# Storage: local (default) or s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./data/uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# Email: until set, the UI states plainly that email cannot be sent
EMAIL_PROVIDER=
EMAIL_FROM=
NEXT_PUBLIC_APP_URL=http://localhost:3000
