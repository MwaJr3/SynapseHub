{
  "name": "contextvault",
  "version": "0.1.0",
  "private": true,
  "description": "ContextVault — an observable, document-grounded RAG workspace.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "worker": "tsx workers/ingestion.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e": "playwright test",
    "evaluate": "tsx scripts/evaluate.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "lint": "eslint app components lib scripts workers tests --ext .ts,.tsx",
    "grant:developer": "tsx scripts/grant-developer.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@next/env": "^15.5.28",
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "next": "15.5.29",
    "pdfjs-dist": "^4.10.38",
    "pg": "8.13.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "yauzl": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.32"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
