# Local default: embedded PostgreSQL + pgvector and fictional demo data.
# Set DATABASE_URL to use a real PostgreSQL server with pgvector installed.
# DATABASE_URL=postgresql://contextvault_app:change-me@localhost:5432/contextvault
# Migration/worker credentials should be separate in production.
# DATABASE_MIGRATION_URL=postgresql://contextvault_migrator:change-me@localhost:5432/contextvault
# DEMO_MODE=false
# The fictional shared demo defaults on only in embedded development. Never enable it publicly.
AI_PROVIDER=mock
EMBEDDING_PROVIDER=mock
# When using OpenAI, document chunks and questions leave your infrastructure.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# Embeddings use text-embedding-3-small at 1536 dimensions.
# STORAGE_PROVIDER=s3
# S3_BUCKET=contextvault
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional OpenAI-compatible self-hosted endpoint (server-side only):
# AI_PROVIDER=local
# EMBEDDING_PROVIDER=local
# LOCAL_AI_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=your-local-chat-model
# LOCAL_EMBEDDING_MODEL=your-1536-dimensional-embedding-model
# LOCAL_AI_API_KEY=
