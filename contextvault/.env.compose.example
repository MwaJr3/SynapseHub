# Copy to .env and fill ALL four secrets with strong, unique values.
# Use URL-safe alphanumeric/hex PostgreSQL passwords (they are inserted in a URL).
# Changing these after the database volume exists does not rotate database roles.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The default stack is private to this machine and sends no text to an AI service.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
AI_PROVIDER=mock
EMBEDDING_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# LOCAL_AI_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_AI_API_KEY=
# LOCAL_LLM_MODEL=your-local-chat-model
# LOCAL_EMBEDDING_MODEL=your-1536-dimensional-embedding-model
