
# ------------------------------------------------ study planner (integration)
# One registered client. The study planner is a separate deployment with its own
# accounts; it receives a read-only `learning-summary:read` grant from the learner,
# never a password or a copied session. Redirect URIs are matched exactly and are a
# comma-separated list, so a preview deployment can be added without a code change.
# Registration happens at startup; nothing can create a client over HTTP.
TESSERA_PLANNER_CLIENT_ID=tamuzi-study-planner
TESSERA_PLANNER_CLIENT_NAME=Tamuzi Study Planner
TESSERA_PLANNER_REDIRECT_URIS=http://localhost:3000/api/tessera/callback
