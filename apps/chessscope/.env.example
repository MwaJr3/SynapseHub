# ChessScope configuration (copy to .env; placeholders only)
CHESSSCOPE_DATA_DIR=data
DATABASE_URL=sqlite:///data/chessscope.db
# Engine path — leave unset to auto-discover the bundled backend/engine/stockfish
# (install with: bash backend/scripts/setup-engine.sh). Set to use another UCI engine:
# CHESSSCOPE_ENGINE=
# Search depth for evaluations (default 12; tests use lower):
# CHESSSCOPE_ENGINE_DEPTH=12
