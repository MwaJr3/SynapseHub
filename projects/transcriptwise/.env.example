# Local development. Copy this file to .env at the project root.
APP_ENV=development
DATABASE_URL=sqlite:///./data/transcriptwise.db
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1,*.e2b.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Honest, no-key development alternative. Not a language model.
AI_PROVIDER=local
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_CHUNK_CHARS=18000
AI_MAX_OUTPUT_TOKENS=6500
AI_TIMEOUT_SECONDS=120

# Official, permissioned YouTube captions only. No arbitrary-video scraping.
# Caption sharing additionally requires an explicit comma-separated video allowlist.
YOUTUBE_ALLOWED_VIDEO_IDS=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

GUEST_RETENTION_DAYS=7
UNSAVED_RETENTION_DAYS=30
SESSION_DAYS=14
MAX_UPLOAD_BYTES=2000000
MAX_TRANSCRIPT_CHARS=300000
MIN_TRANSCRIPT_CHARS=80
DAILY_ANALYSIS_LIMIT=30
REQUESTS_PER_MINUTE=120
EXPENSIVE_REQUESTS_PER_HOUR=30
WORKER_ENABLED=true
SERVE_FRONTEND=false
# Set FRONTEND_PATH only if your built assets are in a nonstandard location.

# Docker Compose only; use a generated URL-safe secret, not a real account password.
POSTGRES_PASSWORD=
APP_PORT=8000
APP_BIND=127.0.0.1
