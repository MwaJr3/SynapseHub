# SecureCode Workbench — code review assistance only.
# Uploaded archives are treated as untrusted: path traversal, zip bombs and
# file-count limits are enforced. Code is NEVER executed.
DATABASE_URL=sqlite:///./data/securecode.db
MAX_ARCHIVE_BYTES=10485760
MAX_UNCOMPRESSED_BYTES=52428800
MAX_FILES=500
MAX_COMPRESSION_RATIO=50
# Optional AI review: OFF by default. Even when enabled, source is only sent
# after explicit per-run user consent, and only to a configured endpoint.
AI_ENABLED=false
AI_ENDPOINT=
