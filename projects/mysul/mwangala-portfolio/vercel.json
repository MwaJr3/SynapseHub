{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/projects",
      "destination": "/portfolio/projects",
      "permanent": false
    },
    {
      "source": "/projects/:slug",
      "destination": "/portfolio/projects/:slug",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/portfolio/about",
      "permanent": false
    },
    {
      "source": "/skills",
      "destination": "/portfolio/skills",
      "permanent": false
    },
    {
      "source": "/approach",
      "destination": "/portfolio/approach",
      "permanent": false
    },
    {
      "source": "/contact",
      "destination": "/portfolio/contact",
      "permanent": false
    },
    {
      "source": "/earlier-work",
      "destination": "/portfolio/earlier-work",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
