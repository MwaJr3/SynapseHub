# ---------------------------------------------------------------------------
# Mwangala portfolio — environment template
#
# Copy this file to `.env` (or `.env.production` for a deploy build) and fill in
# only what you actually have. Every value is optional: the site is designed to
# run with none of them set, and it hides or honestly labels whatever is missing
# instead of inventing it.
#
# Only VITE_-prefixed variables reach the browser. Never put a secret, API key
# or private token in this project — a Vite client bundle is public by design.
# Anything that needs a secret (a contact-form backend, an LLM API key) belongs
# in that separate service, not here.
# ---------------------------------------------------------------------------

# Absolute origin of the deployed site, no trailing slash.
# When set: canonical URLs, og:url, absolute sitemap <loc> values and the
# robots.txt Sitemap: line are emitted.
# When empty: no canonical/og:url is written and the sitemap keeps relative
# paths with an explanatory comment. Do not set this to a placeholder domain.
VITE_SITE_URL=

# Display email address for the contact page and footer.
# When empty, the contact page shows a "not configured yet" state rather than a
# fake address.
VITE_CONTACT_EMAIL=

# Backend that accepts contact-form submissions as POST with a JSON body
# ({ name, email, subject, message }). Must return 2xx on success.
# When empty, the form falls back to an explicit mailto: hand-off and reports
# the message as "drafted" — it never claims delivery it cannot confirm.
VITE_CONTACT_ENDPOINT=

# GitHub account name used to build repository links, e.g. `mwangala`.
# When empty, no repository links are rendered anywhere.
VITE_REPO_OWNER=

# Public base path for built assets. Default "/".
# Set this only when deploying under a sub-path, e.g. a GitHub Pages project
# site served from https://user.github.io/repo/ -> VITE_BASE_PATH=/repo/
# A wrong value shows up as 404s on /assets/* after deploy.
VITE_BASE_PATH=/
