{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SynapseHub",
  "version": "0.2.0",
  "identifier": "com.synapsehub.workspace",
  "build": {
    "beforeDevCommand": "cd ../.. && npm run dev -- --host 0.0.0.0",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../.. && npm run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SynapseHub",
        "url": "synapsehub",
        "width": 1280,
        "height": 850,
        "minWidth": 390,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https:; frame-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
