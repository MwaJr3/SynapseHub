# ---------------------------------------------------------------------------
# Portfolio configuration
#
# Copy this file to `.env.local` and fill in the values you actually own.
# Anything left empty is treated as "not configured": the related button,
# link or section is hidden instead of rendering a placeholder destination.
# Only http(s) URLs are accepted; `javascript:`, `data:` and malformed values
# are rejected at runtime and covered by tests.
# ---------------------------------------------------------------------------

# Production site origin, used for canonical URLs, Open Graph tags and the
# generated sitemap. Example: https://mwangala.dev
VITE_SITE_URL=

# Contact channels. Leave blank until a real address/endpoint exists.
VITE_CONTACT_EMAIL=
# Optional HTTPS endpoint that receives `{ name, email, subject, message }` as
# a JSON POST and performs its own validation, spam protection and rate
# limiting. The contact form is only rendered when this is configured.
VITE_CONTACT_ENDPOINT=
# Optional availability sentence shown on the Contact page and closing CTA.
# Leave blank to avoid implying availability for paid work or partnerships.
VITE_AVAILABILITY_STATEMENT=

# Public profiles.
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=

# ---------------------------------------------------------------------------
# Project deployment links
#
# Live demo and source-code links are NOT wired through environment variables.
# They live in `src/config/deployment.ts`, next to the project slug they belong
# to, so a project can be connected to its application and repository without
# editing components. See docs/CONNECTING_PROJECTS.md.
# ---------------------------------------------------------------------------
