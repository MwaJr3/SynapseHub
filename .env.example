# Copy this file to .env.local and supply only details you actually own.
# Blank values keep the related canonical/profile/contact links hidden.

# Public production origin, for canonical/Open Graph URLs and the sitemap.
VITE_SITE_URL=

# Optional contact details and profiles.
VITE_CONTACT_EMAIL=
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=

# Project demo/repository destinations belong on each record in
# src/data/challengeManifest.ts. Never invent URLs or put secrets in VITE_*.
