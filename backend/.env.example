SUPABASE_URL=https://your-project.supabase.co
# Publishable (or legacy anon) key only. NEVER use a service_role key.
SUPABASE_PUBLISHABLE_KEY=
# Operator-controlled inference endpoint; blank disables generation.
# Local means local to the API server, not necessarily the user's device.
OLLAMA_URL=
OLLAMA_MODEL=
# Optional exact origins for native web development; same-origin web uses Vite proxy.
CORS_ORIGINS=
# Optional credential for a protected existing Ollama-compatible service (server-only).
OLLAMA_API_KEY=

# Cloud is additive; local remains the default. Explicitly select cloud in the UI.
OLLAMA_PROVIDER=local
# The cloud key above is server-only. Local endpoints must use a distinct key.
OLLAMA_LOCAL_API_KEY=
# Ollama Cloud uses https://ollama.com and gemma4:31b in the server adapter.
