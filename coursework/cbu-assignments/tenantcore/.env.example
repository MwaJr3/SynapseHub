# LOCAL DEVELOPMENT EXAMPLE ONLY — replace every secret in production.
ENVIRONMENT=development
DEMO_MODE=true
POSTGRES_DB=tenantcore
POSTGRES_USER=tenantcore
POSTGRES_PASSWORD=tenantcore_dev
TENANTCORE_APP_PASSWORD=tenantcore_app_dev
DATABASE_URL=postgresql+psycopg://tenantcore_app:tenantcore_app_dev@localhost:5432/tenantcore
MIGRATION_DATABASE_URL=postgresql+psycopg://tenantcore:tenantcore_dev@localhost:5432/tenantcore
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=development-only-change-me-32-bytes
CORS_ORIGINS=http://localhost:5309
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
RATE_LIMIT_FAIL_OPEN=true
LOG_LEVEL=INFO

# Tests opt in separately and permit destructive reset only of their test database.
RUN_POSTGRES_TESTS=0
TEST_DATABASE_URL=postgresql+psycopg://tenantcore_app:tenantcore_app_test_dev@localhost:5433/tenantcore_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://tenantcore:tenantcore_test_dev@localhost:5433/tenantcore_test
TEST_REDIS_URL=redis://localhost:6380/0
TENANTCORE_TEST_ALLOW_RESET=NO
# PGlite compatibility only; leave both role settings unset for official PostgreSQL.
# DATABASE_ROLE=tenantcore_app
# TEST_DATABASE_ROLE=tenantcore_app
